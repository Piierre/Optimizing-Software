<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Permet de compiler les projets Windows (WPF) depuis Linux ou macOS, par exemple en CI. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Version de l'appli : affichée dans la fenêtre, utilisée par l'installeur et la recherche de mises à jour. -->
    <Version>0.7.0</Version>
  </PropertyGroup>
</Project>
