<Application x:Class="OptimizingSoftware.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="System"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="ProblemBrush" Color="#D13438" />
        <SolidColorBrush x:Key="WarningBrush" Color="#C27C0E" />
        <SolidColorBrush x:Key="OkBrush" Color="#107C10" />
        <SolidColorBrush x:Key="UnknownBrush" Color="#8A8886" />
    </Application.Resources>
</Application>
