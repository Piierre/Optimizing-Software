<Window x:Class="OptimizingSoftware.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OptimizingSoftware.App.ViewModels"
        xmlns:local="clr-namespace:OptimizingSoftware.App"
        Title="Optimizing Software" Height="760" Width="1040" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen" Icon="Assets/icon.ico">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:BrushKeyConverter x:Key="BrushKey" />
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
    </Window.Resources>

    <DockPanel>
    <!-- Bandeau de mise à jour, affiché seulement quand une version plus récente est publiée. -->
    <Border x:Name="UpdateBanner" DockPanel.Dock="Top" Visibility="Collapsed" Margin="16,12,16,0" Padding="12,8" CornerRadius="8"
            Background="{DynamicResource AccentFillColorDefaultBrush}">
        <DockPanel>
            <Button x:Name="UpdateButton" DockPanel.Dock="Right" Content="Télécharger" Padding="12,4" Click="OnUpdateClick" />
            <TextBlock x:Name="UpdateText" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
    </Border>

    <TabControl x:Name="Tabs" Margin="16,8,16,16">
        <!-- ============ Onglet : accueil (Analyser → Nettoyer) ============ -->
        <TabItem Header="Accueil" x:Name="HomeTab">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,24,24,16" MaxWidth="860">
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Headline}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Subline}" Opacity="0.7" TextWrapping="Wrap" Margin="0,4,12,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Nettoyer" Command="{Binding CleanCommand}" Padding="28,10" FontSize="16"
                                VerticalAlignment="Center" Style="{DynamicResource AccentButtonStyle}" />
                    </Grid>

                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,12"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                    <Border Style="{StaticResource Card}" Padding="0">
                        <ItemsControl ItemsSource="{Binding Lines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="16,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding HasItems}" VerticalAlignment="Center" MinWidth="0" Margin="0,0,8,0" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Detail}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0" />
                                            <Button Grid.Column="3" Content="Voir" Padding="10,4" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.ShowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Target}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <TextBlock Text="{Binding Result}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="14" />

                    <WrapPanel Margin="0,16,0,0">
                        <Button Content="Analyser à nouveau" Command="{Binding AnalyzeCommand}" Padding="12,6" Margin="0,0,8,8" />
                        <Button Content="Corbeille (7 jours)" Command="{Binding ShowCommand}" CommandParameter="cleanup" Padding="12,6" Margin="0,0,8,8" />
                    </WrapPanel>
                    <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="Pour les gros fichiers, les doublons et désinstaller un jeu ou un logiciel, passe par les autres onglets." />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ============ Onglet : nettoyage ============ -->
        <TabItem Header="Nettoyage" x:Name="CleanupTab">
            <DockPanel Margin="8,16,8,0">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Nettoyage" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="Retire ce qui s'accumule avec le temps. Tout passe par une corbeille : tu peux restaurer pendant 7 jours."
                                   TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="100" Margin="0,0,12,0"
                                     Visibility="{Binding CleanCommand.IsRunning, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding SelectedTotal}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Content="Analyser" Command="{Binding ScanCommand}" Padding="16,8" Margin="0,0,8,0" />
                        <Button Content="Nettoyer la sélection" Command="{Binding CleanCommand}" Padding="16,8"
                                Style="{DynamicResource AccentButtonStyle}" />
                    </StackPanel>
                </Grid>

                <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,12" />

                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12"
                        Visibility="{Binding IsNotAdministrator, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Relancer en administrateur" Command="{Binding RestartAsAdminCommand}"
                                Padding="12,6" VerticalAlignment="Center" />
                        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                                   Text="Avec les droits administrateur, l'appli peut aussi vider les fichiers temporaires de Windows, les téléchargements de Windows Update et les anciens journaux d'installation." />
                    </DockPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="380" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CategoryItem}">
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,2,8,0" />
                                            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding Size}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding Detail}" FontSize="12" Opacity="0.65" HorizontalAlignment="Right" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0" Opacity="0.85" />
                                                <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                           Foreground="{StaticResource WarningBrush}"
                                                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Corbeille interne + corbeille de Windows -->
                    <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="Vider" Command="{Binding EmptyCommand}" Padding="10,4"
                                        Visibility="{Binding HasSessions, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="Corbeille" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{Binding QuarantineTotal}" TextWrapping="Wrap" FontSize="12" Opacity="0.7" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Sessions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SessionItem}">
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap" Opacity="0.75" />
                                            <TextBlock Text="{Binding Expires}" FontSize="12" Opacity="0.6" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Button Content="Restaurer" Padding="10,4" Margin="0,0,8,0"
                                                        Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Supprimer" Padding="10,4"
                                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="Vider" Command="{Binding EmptyRecycleBinCommand}" Padding="10,4"
                                        Visibility="{Binding RecycleBinHasItems, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="Corbeille de Windows" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{Binding RecycleBinText}" TextWrapping="Wrap" FontSize="12" Opacity="0.7" />
                            <TextBlock Text="Attention : vider la corbeille de Windows est définitif." TextWrapping="Wrap" FontSize="12"
                                       Foreground="{StaticResource WarningBrush}" Margin="0,4,0,0"
                                       Visibility="{Binding RecycleBinHasItems, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </TabItem>

        <!-- ============ Onglet : applications ============ -->
        <TabItem Header="Jeux et logiciels" x:Name="AppsTab">
            <DockPanel Margin="8,16,8,0">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Jeux et logiciels" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,4,12,0"
                                   Text="Désinstalle ce qui ne sert plus, puis retire les dossiers et les entrées que les applications laissent derrière elles. Tout passe par la corbeille (7 jours pour changer d'avis)." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="Relancer en administrateur" Command="{Binding RestartAsAdminCommand}" Padding="12,8" Margin="0,0,8,0"
                                Visibility="{Binding IsNotAdministrator, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Nécessaire pour les dossiers de Program Files et ProgramData, et les entrées installées pour tout le PC." />
                        <Button Content="Analyser" Command="{Binding ScanCommand}" Padding="16,8"
                                Style="{DynamicResource AccentButtonStyle}" />
                    </StackPanel>
                </Grid>

                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True" Width="100"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>

                <TabControl SelectedIndex="{Binding Section}" IsEnabled="{Binding IsIdle}">
                    <!-- Applications installées -->
                    <TabItem Header="Jeux et logiciels">
                        <DockPanel Margin="0,8,0,0">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding AppsSummary}" Opacity="0.7" VerticalAlignment="Center" Margin="12,0,0,0" />
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox SelectedIndex="{Binding Category}" Width="150" Margin="0,0,8,0">
                                        <ComboBoxItem Content="Tout" />
                                        <ComboBoxItem Content="Jeux" />
                                        <ComboBoxItem Content="Logiciels" />
                                    </ComboBox>
                                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="320"
                                             ToolTip="Chercher par nom, éditeur ou launcher (Steam, Epic…)" />
                                </StackPanel>
                            </DockPanel>
                            <DataGrid ItemsSource="{Binding AppsView}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="3*" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="80" />
                                    <DataGridTextColumn Header="Taille" Binding="{Binding Size}" SortMemberPath="SortSize" Width="90" />
                                    <DataGridTextColumn Header="Disque" Binding="{Binding Drive}" Width="60" />
                                    <DataGridTextColumn Header="Launcher" Binding="{Binding Source}" Width="100" />
                                    <DataGridTextColumn Header="Éditeur" Binding="{Binding Publisher}" Width="2*" />
                                    <DataGridTextColumn Header="Installée le" Binding="{Binding Installed}" SortMemberPath="App.InstallDate" Width="100" />
                                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="*" />
                                    <DataGridTemplateColumn Header="" Width="Auto" MinWidth="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding UninstallLabel}" Padding="8,2"
                                                        Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <!-- Dossiers restants -->
                    <TabItem Header="Dossiers restants">
                        <DockPanel Margin="0,8,0,0">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <TextBlock Text="{Binding LeftoversTotal}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <Button Content="Déplacer dans la corbeille" Command="{Binding CleanLeftoversCommand}" Padding="16,8"
                                            Style="{DynamicResource AccentButtonStyle}" />
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,12,0"
                                           Text="Dossiers de Program Files et AppData qui ne correspondent à aucune application installée et qui n'ont pas bougé depuis 2 mois. Seuls les cas clairs sont cochés." />
                            </DockPanel>
                            <DataGrid ItemsSource="{Binding Leftovers}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="40">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Dossier" Binding="{Binding Name}" Width="2*" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Taille" Binding="{Binding Size}" SortMemberPath="SizeBytes" Width="90" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Modifié" Binding="{Binding Modified}" Width="100" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Pourquoi" Binding="{Binding Reason}" Width="3*" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Dans" Binding="{Binding Parent}" Width="2*" IsReadOnly="True" />
                                    <DataGridTemplateColumn Header="" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Afficher" Padding="8,2"
                                                        Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                        CommandParameter="{Binding Path}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <!-- Entrées cassées -->
                    <TabItem Header="Entrées cassées">
                        <DockPanel Margin="0,8,0,0">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <TextBlock Text="{Binding BrokenTotal}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <Button Content="Retirer de la liste" Command="{Binding RemoveBrokenCommand}" Padding="16,8"
                                            Style="{DynamicResource AccentButtonStyle}" />
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,12,0"
                                           Text="Applications encore listées dans « Applications installées » de Windows alors qu'elles ont disparu. Chaque entrée est sauvegardée avant d'être retirée." />
                            </DockPanel>
                            <DataGrid ItemsSource="{Binding Broken}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="40">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="2*" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Éditeur" Binding="{Binding Publisher}" Width="*" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Installée pour" Binding="{Binding Where}" Width="*" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Pourquoi" Binding="{Binding Reason}" Width="3*" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </TabItem>

        <!-- ============ Onglet : démarrage et processus ============ -->
        <TabItem Header="Démarrage et processus" x:Name="StartupTab">
            <DockPanel Margin="8,16,8,0">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Démarrage et processus" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,4,12,0"
                                   Text="Moins de programmes au démarrage, c'est un PC qui démarre plus vite et plus de mémoire libre pour les jeux. Désactiver ne désinstalle rien : tu peux réactiver à tout moment." />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Analyser" Command="{Binding RefreshCommand}" Padding="16,8" VerticalAlignment="Top"
                            Style="{DynamicResource AccentButtonStyle}" />
                </Grid>

                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True" Width="100"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>

                <TabControl SelectedIndex="{Binding Section}" IsEnabled="{Binding IsIdle}">
                    <TabItem Header="Au démarrage">
                        <DockPanel Margin="0,8,0,0">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="Désactiver ceux conseillés" Command="{Binding DisableSuggestedCommand}" Padding="16,8"
                                        Style="{DynamicResource AccentButtonStyle}" />
                                <TextBlock Text="{Binding StartupSummary}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <DataGrid ItemsSource="{Binding Startup}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Conseil" Width="110" SortMemberPath="Rank">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="10" Padding="8,1" HorizontalAlignment="Left"
                                                        Background="{Binding AdviceBrush, Converter={StaticResource BrushKey}}">
                                                    <TextBlock Text="{Binding AdviceText}" Foreground="White" FontSize="12" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="2*" />
                                    <DataGridTextColumn Header="État" Binding="{Binding StateText}" Width="90" />
                                    <DataGridTextColumn Header="Éditeur" Binding="{Binding Publisher}" Width="2*" />
                                    <DataGridTextColumn Header="Pour" Binding="{Binding Scope}" Width="90" />
                                    <DataGridTextColumn Header="Pourquoi" Binding="{Binding Reason}" Width="4*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="" Width="190">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="{Binding ToggleText}" Padding="8,2" Margin="0,0,6,0"
                                                            Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Afficher" Padding="8,2"
                                                            Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                            CommandParameter="{Binding Path}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Processus">
                        <DockPanel Margin="0,8,0,0">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <CheckBox DockPanel.Dock="Right" Content="Seulement ceux à surveiller" IsChecked="{Binding OnlyFlagged}" />
                                <TextBlock Text="{Binding ProcessesSummary}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8"
                                       Text="« Suspect » ne veut pas dire virus : ce sont des signes qui méritent un coup d'œil (nom d'un programme de Windows au mauvais endroit, programme sans signature dans un dossier temporaire, mineur connu). En cas de doute, lance une analyse complète avec Microsoft Defender." />
                            <DataGrid ItemsSource="{Binding ProcessesView}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="95" SortMemberPath="Rank">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="10" Padding="8,1" HorizontalAlignment="Left"
                                                        Background="{Binding VerdictBrush, Converter={StaticResource BrushKey}}">
                                                    <TextBlock Text="{Binding VerdictText}" Foreground="White" FontSize="12" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Programme" Binding="{Binding Name}" Width="2*" />
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*" />
                                    <DataGridTextColumn Header="Mémoire" Binding="{Binding Memory}" SortMemberPath="MemoryBytes" Width="90" />
                                    <DataGridTextColumn Header="Processeur" Binding="{Binding Cpu}" SortMemberPath="CpuPercent" Width="90" />
                                    <DataGridTextColumn Header="Éditeur" Binding="{Binding Publisher}" Width="2*" />
                                    <DataGridTextColumn Header="Signature" Binding="{Binding Signature}" Width="90" />
                                    <DataGridTextColumn Header="Pourquoi" Binding="{Binding Reasons}" Width="4*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="" Width="260">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Fermer" Padding="8,2" Margin="0,0,6,0" IsEnabled="{Binding CanClose}"
                                                            Command="{Binding DataContext.CloseProcessCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Afficher" Padding="8,2" Margin="0,0,6,0"
                                                            Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                            CommandParameter="{Binding Path}" />
                                                    <Button Content="Chercher en ligne" Padding="8,2"
                                                            Command="{Binding DataContext.SearchOnlineCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                            CommandParameter="{Binding Name}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </TabItem>

        <!-- ============ Onglet : fichiers personnels ============ -->
        <TabItem Header="Fichiers" x:Name="FilesTab">
            <DockPanel Margin="8,16,8,0">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,12,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="Vieux téléchargements" Command="{Binding ScanDownloadsCommand}" Padding="12,8" Margin="0,0,8,0" />
                        <Button Content="Gros fichiers" Command="{Binding ScanLargeCommand}" Padding="12,8" Margin="0,0,8,0" />
                        <Button Content="Doublons" Command="{Binding ScanDuplicatesCommand}" Padding="12,8" />
                    </StackPanel>
                </Grid>

                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12" IsEnabled="{Binding IsIdle}">
                    <TextBlock Text="Disques à analyser :" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"
                               ToolTip="Sur le disque de Windows, seuls tes dossiers personnels sont parcourus (Bureau, Documents, Téléchargements…). Les autres disques sont parcourus en entier, sauf les jeux installés." />
                    <ItemsControl ItemsSource="{Binding Drives}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}" Margin="0,0,16,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>

                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ProgressBar IsIndeterminate="True" Width="100" Margin="0,0,8,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Annuler" Command="{Binding CancelScanCommand}" Padding="10,4" Margin="0,0,12,0"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding SelectedTotal}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Content="Tout décocher" Command="{Binding SelectNoneCommand}" Padding="12,8" Margin="0,0,8,0" />
                        <Button Content="Déplacer dans la corbeille" Command="{Binding CleanCommand}" Padding="16,8"
                                Style="{DynamicResource AccentButtonStyle}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>

                <DataGrid ItemsSource="{Binding View}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single" IsReadOnly="False">
                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="4,12,0,4" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="2*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Taille" Binding="{Binding Size}" SortMemberPath="SizeBytes" Width="90" IsReadOnly="True" />
                        <DataGridTextColumn Header="Modifié" Binding="{Binding Modified}" Width="100" IsReadOnly="True" />
                        <DataGridTextColumn Header="Pourquoi" Binding="{Binding Reason}" Width="2*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Dossier" Binding="{Binding Folder}" Width="2*" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Afficher" Padding="8,2"
                                            Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <!-- ============ Onglet : vérifications ============ -->
        <TabItem Header="Vérifications" x:Name="DiagnosticTab">
            <DockPanel Margin="8,16,8,0">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Diagnostic performances" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="Trouve ce qui ralentit le PC, sans rien modifier." Opacity="0.7" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="120" Margin="0,0,12,0"
                                     Visibility="{Binding RunDiagnosticCommand.IsRunning, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Relancer le diagnostic" Command="{Binding RunDiagnosticCommand}"
                                Padding="16,8" Style="{DynamicResource AccentButtonStyle}" />
                    </StackPanel>
                </Grid>

                <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" Foreground="{StaticResource ProblemBrush}" TextWrapping="Wrap"
                           Margin="0,0,0,12" />

                <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"
                           Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}" />

                <Grid Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="380" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Checks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CheckItemViewModel}">
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" CornerRadius="10" Padding="10,2"
                                                        Background="{Binding BrushKey, Converter={StaticResource BrushKey}}">
                                                    <TextBlock Text="{Binding StatusLabel}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                            <TextBlock Text="{Binding Advice}" TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.75"
                                                       Visibility="{Binding HasAdvice, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Ton PC" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Inventory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:InventoryLine}">
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Label}" FontSize="12" Opacity="0.65" />
                                            <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </TabItem>

        <!-- ============ Onglet : enregistrement en jeu (secondaire) ============ -->
        <TabItem Header="Enregistrement en jeu" x:Name="RecordingTab">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8,16,8,0">
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Qu'est-ce qui limite en jeu ?" FontSize="26" FontWeight="SemiBold" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" MaxWidth="640" HorizontalAlignment="Left"
                                       Text="1. Clique sur Démarrer.  2. Lance ton jeu et joue 2 à 10 minutes à un passage qui rame.  3. Reviens ici et clique sur Arrêter et analyser." />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Elapsed}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"
                                       Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="Démarrer" Command="{Binding StartCommand}" Padding="16,8" Margin="0,0,8,0"
                                    Style="{DynamicResource AccentButtonStyle}" />
                            <Button Content="Arrêter et analyser" Command="{Binding StopCommand}" Padding="16,8" />
                        </StackPanel>
                    </Grid>

                    <!-- Mesures en direct -->
                    <ItemsControl ItemsSource="{Binding Live}" Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LiveGauge}">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="8" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Text}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Résultat -->
                    <StackPanel Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" BorderThickness="0,0,0,0">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="6" CornerRadius="3" Margin="0,0,14,0"
                                        Background="{Binding BrushKey, Converter={StaticResource BrushKey}}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Verdict}" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Que faire" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding Upgrades}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat='•  {0}'}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding Warnings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat='⚠  {0}'}" TextWrapping="Wrap" Margin="0,0,0,6"
                                                       Foreground="{StaticResource WarningBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Mesures pendant la partie" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,4" Opacity="0.65">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Mesure" />
                                    <TextBlock Grid.Column="1" Text="Moyenne" />
                                    <TextBlock Grid.Column="2" Text="Pic (95 %)" />
                                    <TextBlock Grid.Column="3" Text="Max" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Stats}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:StatLine}">
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="260" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="100" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Average}" />
                                                <TextBlock Grid.Column="2" Text="{Binding P95}" />
                                                <TextBlock Grid.Column="3" Text="{Binding Max}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
    </DockPanel>
</Window>
