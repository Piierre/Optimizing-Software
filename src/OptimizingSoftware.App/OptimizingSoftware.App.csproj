<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>OptimizingSoftware</AssemblyName>
    <Product>Optimizing Software</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <!-- ThemeMode (thème Fluent de WPF) est encore marqué expérimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OptimizingSoftware.Core\OptimizingSoftware.Core.csproj" />
    <ProjectReference Include="..\OptimizingSoftware.Windows\OptimizingSoftware.Windows.csproj" />
  </ItemGroup>

</Project>
